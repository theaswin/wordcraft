<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="action_open_customer_statement_from_partner" model="ir.actions.server">
            <field name="name">Customer Statement</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>

            <!-- ✅ GROUP RESTRICTION -->
            <field name="group_ids" eval="[(4, ref('tk_customer_statements.customer_statement_group'))]"/>

            <field name="code"><![CDATA[
action = {
    'type': 'ir.actions.act_window',
    'name': 'Customer Statement',
    'res_model': 'customer.statement.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {
        'default_partner_id': record.id,
    }
}
            ]]></field>
        </record>

    </data>
</odoo>
