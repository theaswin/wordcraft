<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban view -->
    <record id="view_project_kanban_deadline_hrs" model="ir.ui.view">
        <field name="name">project.project.kanban.deadline.hrs</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">

            <!-- Load fields into kanban -->
            <xpath expr="//kanban" position="inside">
                <field name="assignee_ids"/>
                <field name="project_assignee_ids"/>
            </xpath>

            <!-- Show below date -->
            <xpath expr="//div[@t-if='record.date.raw_value or record.date_start.raw_value']"
                   position="after">

                <div t-if="record.project_assignee_ids.raw_value"
                     class="d-flex align-items-baseline text-danger fw-bold">
                    <span class="fa fa-folder-open me-2 text-muted"/>

                    <span>
                        <field name="project_assignee_ids" widget="many2many_tags"/>
                    </span>
                </div>

                <div t-if="record.assignee_ids.raw_value"
                     class="d-flex align-items-baseline text-danger fw-bold">
                        <span class="fa fa-tasks me-2 text-muted"/>

                    <span>
                        <field name="assignee_ids" widget="many2many_tags"/>
                    </span>
                </div>

            </xpath>

        </field>
    </record>

    <!-- Form view -->
    <record id="view_project_form_in_phase" model="ir.ui.view">
        <field name="name">project.project.form.phase</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="hr_timesheet.project_invoice_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='date']" position="after">
                <field name="project_assignee_ids" widget="many2many_tags"/>
            </xpath>

        </field>
    </record>

</odoo>
