<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    

        <record id="res_partner_form_inherit_related_person" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.related.person</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='user_id']" position="after">
                <field name="related_person_id"/>
            </xpath>

        </field>
    </record>

        


    <record id="action_view_credit_statements" model="ir.actions.server">
        <field name="name">View Due Statements</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">
            action = records.action_view_credit_statements()
        </field>
    </record>

</odoo>
