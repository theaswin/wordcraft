<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_invoice_document_invoice_to_div" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@class='row']" position="replace">

            <div class="row">

                <!-- LEFT SIDE -->
                <div class="col-6" style="text-align:left;">

                    <strong style="color:#0d6efd; font-weight:700;">
                        Invoice To:
                    </strong><br/>

                    <strong><span t-field="o.partner_id.name"/></strong>

                    <div t-if="o.partner_id.mobile">
                    <span t-field="o.partner_id.mobile"/>
                    </div>

                    <div t-if="o.partner_id.email">
                        <span t-field="o.partner_id.email"/>
                    </div>

                    <div t-if="o.partner_id.vat">
                        <strong>
                            <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                            <t t-else="">TRN</t>:
                        </strong>
                        <span t-field="o.partner_id.vat"/>
                    </div>

                    <div>
                        <span t-field="o.partner_id.street"/>
                        <t t-if="o.partner_id.street2">
                            , <span t-field="o.partner_id.street2"/>
                        </t>
                        <t t-if="o.partner_id.city">
                            , <span t-field="o.partner_id.city"/>
                        </t>
                        <t t-if="o.partner_id.state_id">
                            , <span t-field="o.partner_id.state_id.name"/>
                        </t>
                        <t t-if="o.partner_id.zip">
                            - <span t-field="o.partner_id.zip"/>
                        </t>
                        <br/>
                    </div>

                </div>

                <!-- RIGHT SIDE -->
                <div class="col-6" style="text-align:right;">
                    <t t-if="o.invoice_user_id">
                        <strong style="color:#0d6efd; font-weight:700;">
                            Sales Person:
                        </strong>
                        <span t-field="o.invoice_user_id.name"/>
                    </t>
                </div>

            </div>

            <br/>
            <br/>

        </xpath>
    </template>
</odoo>
