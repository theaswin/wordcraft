<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_saleorder_document_invoice_to_div"
              inherit_id="sale.report_saleorder_document">

        <!-- Replace customer address block -->
        <xpath expr="//t[@t-set='address']" position="replace">

            <t t-set="address">
                <div style="width:100%;">

                    <!-- Top Row -->
                    <div style="display:flex; justify-content:space-between; width:100%;">

                        <!-- Invoice To -->
                        <div style="width:70%; text-align:left;">
                            <strong style="color:#0d6efd; font-weight:700;">
                                To:
                            </strong><br/>
                            <span t-field="doc.partner_id.name"/>
                        </div>

                        <!-- Sales Person -->
                        

                    </div>

                    <!-- Mobile -->
                    <div t-if="doc.partner_id.mobile">
                        <span t-field="doc.partner_id.mobile"/>
                    </div>

                    <!-- Email -->
                    <div t-if="doc.partner_id.email">
                        <span t-field="doc.partner_id.email"/>
                    </div>

                    <!-- TRN / VAT -->
                    <div t-if="doc.partner_id.vat">
                        <strong>
                            <t t-if="doc.company_id.account_fiscal_country_id.vat_label"
                               t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                            <t t-else="">TRN</t>:
                        </strong>
                        <span t-field="doc.partner_id.vat"/>
                    </div>

                    <!-- Address -->
                    <div>
                        <span t-field="doc.partner_id.street"/>
                        <t t-if="doc.partner_id.street2">
                            , <span t-field="doc.partner_id.street2"/>
                        </t>
                        <t t-if="doc.partner_id.city">
                            , <span t-field="doc.partner_id.city"/>
                        </t>
                        <t t-if="doc.partner_id.state_id">
                            , <span t-field="doc.partner_id.state_id.name"/>
                        </t>
                        <t t-if="doc.partner_id.zip">
                            - <span t-field="doc.partner_id.zip"/>
                        </t>
                        <br/>
                        <span t-field="doc.partner_id.country_id.name"/>
                    </div>

                </div>
            </t>

        </xpath>

    </template>
</odoo>
