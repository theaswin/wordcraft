<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_task_kanban_deadline_hrs" model="ir.ui.view">
        <field name="name">project.task.kanban.deadline.hrs</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">

            <!-- Load field into kanban -->
            <xpath expr="//kanban" position="inside">
                <field name="deadline_hrs"/>
            </xpath>

            <!-- Show below date_deadline -->
<xpath expr="//field[@name='date_deadline']" position="after">
    <t t-if="record.deadline_hrs.raw_value and
             !['1_done','1_canceled'].includes(record.state.raw_value)">

        <!-- RED: less than 3 hours -->
        <div t-if="record.deadline_hrs.raw_value &lt; 3"
             class="d-flex align-items-baseline text-danger fw-bold">
            <span class="fa fa-hourglass-half me-1"/>
            <field name="deadline_hrs"/> hrs remaining
        </div>

        <!-- YELLOW: 3 to 5 hours -->
        <div t-elif="record.deadline_hrs.raw_value &lt;= 5"
             class="d-flex align-items-baseline text-warning fw-bold">
            <span class="fa fa-hourglass-half me-1"/>
            <field name="deadline_hrs"/> hrs remaining
        </div>

        <!-- GREEN: greater than 5 hours -->
        <div t-else=""
             class="d-flex align-items-baseline text-success">
            <span class="fa fa-hourglass-half me-1"/>
            <field name="deadline_hrs"/> hrs remaining
        </div>

    </t>
</xpath>

        </field>
    </record>

</odoo>
